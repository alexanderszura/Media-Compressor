{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Compressor",
  "version": "0.1.0",
  "identifier": "com.aszura.mediacompressor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Media Compressor",
        "width": 1100,
        "height": 740,
        "minWidth": 780,
        "minHeight": 540,
        "dragDropEnabled": true,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERjI3NzdGMDNBMzQ1QjIKUldTeVJhTURmM2Z5amZ3REpKemQ3aWFaWjJJVG82QW8xelcrMHhKUWtRUHpxUlRvQklHUC85cFUK",
      "endpoints": [
        "https://github.com/alexanderszura/Media-Compressor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
